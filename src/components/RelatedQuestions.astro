---
export interface Props {
  questions: string[];
  title?: string;
}
const { questions, title = 'Related searches' } = Astro.props;
---
<section class="related-q">
  {title && <h2>{title}</h2>}
  <ul>
    {questions.map(q => <li><span class="badge">Q</span><span class="q">{q}</span></li>)}
  </ul>
</section>
<style>
  .related-q { margin: 30px 0; }
  ul { list-style: none; padding: 0; display: grid; gap: 6px; }
  li { display: flex; align-items: baseline; gap: 10px; padding: 8px 12px; border-radius: 8px; background: #fff; border: 1px solid var(--border); }
  .badge { background: var(--brand); color: #fff; border-radius: 6px; font-weight: 700; font-size: 11px; padding: 2px 7px; flex-shrink: 0; }
  .q { color: var(--fg); font-size: 14px; }
</style>
