---
// Root-level 404 — language-neutral.
// With this file built to /404.html, CF Pages serves a real 404 status for
// unmatched routes instead of the SPA fallback (index.html @ 200 = soft-404,
// which de-indexed the whole site — every unknown URL looked like the homepage).
// public/_worker.js 301s unprefixed paths to /en/<path> before this renders;
// this page only shows for genuinely-missing locale-prefixed URLs.
import { SITE } from '~/lib/site';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>404 — not found — {SITE.name}</title>
  <style>
    :root { color-scheme: light; }
    * { box-sizing: border-box; }
    body { margin: 0; font: 16px/1.6 ui-sans-serif, system-ui, -apple-system, sans-serif;
           background: #faf9f6; color: #1a1a1a; display: grid; place-items: center; min-height: 100vh; }
    .card { max-width: 520px; padding: 48px 32px; text-align: center; }
    h1 { font-size: 4rem; margin: 0; letter-spacing: -0.04em; }
    p { color: #555; margin: 12px 0 24px; }
    a.btn { display: inline-block; padding: 10px 22px; background: #1a6b54; color: #fff;
            border-radius: 8px; text-decoration: none; font-weight: 600; }
    a.btn:hover { background: #14563f; }
  </style>
</head>
<body>
  <div class="card">
    <h1>404</h1>
    <p>This page doesn't exist. It may have moved to a locale-prefixed URL.</p>
    <a class="btn" href="/en/">Go to unitbox →</a>
  </div>
  <script is:inline>
    // Best-effort: retry the same path under the default locale
    // (pre-locale-prefix URLs land here only if the worker 301 didn't apply).
    (function () {
      var p = location.pathname;
      if (!/^\/(en|zh-hans|zh-hant|ja|ko)(\/|$)/.test(p) && !/\.[a-z0-9]+$/i.test(p)) {
        location.replace('/en' + (p.endsWith('/') ? p : p + '/'));
      }
    })();
  </script>
</body>
</html>
