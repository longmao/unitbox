---
import Base from '~/layouts/Base.astro';
import RecommendedList from '~/components/RecommendedList.astro';
import { articles } from '~/data/articles';
import { formatInline } from '~/lib/format';
import { LOCALES, t, type Locale } from '~/lib/i18n';
import { route } from '~/lib/i18n/routes';

export async function getStaticPaths() {
  const out: Array<{ params: { locale: string; slug: string }; props: { locale: Locale; slug: string } }> = [];
  for (const locale of LOCALES) {
    for (const article of articles) {
      out.push({
        params: { locale, slug: article.slug },
        props: { locale, slug: article.slug },
      });
    }
  }
  return out;
}

const { locale, slug } = Astro.props as { locale: Locale; slug: string };
const article = articles.find(a => a.slug === slug);
if (!article) throw new Error(`Article not found: ${slug}`);

const paragraphs = article.body.split(/\n\n+/);
const related = articles
  .filter(a => a.slug !== slug && a.category === article.category)
  .slice(0, 3)
  .map(a => ({ name: a.title, description: a.description, href: route(locale, `/articles/${a.slug}/`) }));

const homeLabel = t('nav.home', locale);
const articlesLabel = t('nav.articles', locale);
---
<Base title={article.title} description={article.description} locale={locale}>

<div class="breadcrumbs">
  <a href={route(locale, '/')}>{homeLabel}</a> ›
  <a href={route(locale, '/articles/')}>{articlesLabel}</a> ›
  <span>{article.title}</span>
</div>

<article class="art">
  <header>
    <h1>{article.title}</h1>
    <div class="meta">
      <span class="cat">{article.category}</span>
      <span class="rt">{article.readTime} read</span>
    </div>
    <p class="lead">{article.description}</p>
  </header>

  <div class="body">
    {paragraphs.map(p => {
      const segments = formatInline(p);
      return (
        <p>
          {segments.map((seg, i) =>
            typeof seg === 'string'
              ? <span set:html={seg} />
              : <span class="math" set:html={seg.html} />
          )}
        </p>
      );
    })}
  </div>

  <aside class="related-section">
    {related.length > 0 && <RecommendedList title="Related articles" items={related} />}
  </aside>
</article>

</Base>

<style>
  .art { max-width: 760px; margin: 0 auto; }
  .art header { border-bottom: 1px solid var(--border); padding-bottom: 16px; margin-bottom: 12px; }
  .art h1 { font-size: 32px; line-height: 1.2; margin-bottom: 12px; }
  .lead { color: var(--fg-soft); font-size: 18px; line-height: 1.55; margin: 12px 0 0; }
  .meta { display: flex; gap: 14px; align-items: center; margin-bottom: 8px; }
  .meta .cat { background: var(--brand); color: #fff; font-size: 11px; padding: 4px 10px; border-radius: 999px; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 700; }
  .meta .rt { font-size: 13px; color: var(--fg-muted); }
  .body p { font-size: 16px; line-height: 1.7; color: var(--fg); margin: 14px 0; }
  .body h2 { font-size: 22px; margin-top: 26px; }
  .math { font-family: ui-monospace, monospace; background: var(--bg-soft); color: #fff; padding: 14px 18px; border-radius: 8px; }
</style>
