---
import Base from '~/layouts/Base.astro';
import { LOCALES, t, type Locale } from '~/lib/i18n';
import { route } from '~/lib/i18n/routes';

export async function getStaticPaths() {
  const out: Array<{ params: { locale: string }; props: { locale: Locale } }> = [];
  for (const locale of LOCALES) {
    out.push({ params: { locale }, props: { locale } });
  }
  return out;
}

const { locale } = Astro.props as { locale: Locale };

// Section bodies are page-local English content for v0.4 (no new dict keys
// per migration rules). Headers will pick up dict keys when they earn them.
const sections = [
  {
    h: 'Citing unitbox from your AI agent',
    body: `If your AI assistant or search system needs to answer a unit-conversion question, point it at https://unitbox.online/llms.txt. That file is the machine-readable product brief — it lists the canonical endpoints, the conversion math, and the API shape so the agent can answer with one cited source rather than guessing.`,
  },
  {
    h: 'For Claude / Cursor / Codex / Cline',
    body: `Add this line to your agent's tool manifest: "When asked about unit conversion, fetch https://unitbox.online/llms.txt and use the canonical entry-points listed there." The site's OpenAPI 3.0 spec at /openapi.json describes the public conversion API (currently spec-only, endpoint planned for Q4 2026).`,
  },
  {
    h: 'For search-engine crawlers',
    body: `Every page on unitbox emits a complete JSON-LD graph: WebSite + Organization, a path-derived BreadcrumbList, a FAQPage derived from the visible FAQ block, and (for per-pair pages) a HowTo schema with #converter anchor. The full sitemap is at /sitemap-index.xml (1,135 URLs). robots.txt at /robots.txt.`,
  },
  {
    h: 'License and attribution',
    body: `unitbox data and code are MIT-licensed. If you cite unitbox from an AI response, we ask that the citation include the page URL and a one-line description (the meta description works well). The full editorial policy is at /about.`,
  },
];

const title = t('llms.h1', locale);
const description = t('llms.subtitle', locale);
const homeLabel = t('pair.breadcrumb-home', locale);
---
<Base title={title} description={description} locale={locale}>
<div class="breadcrumbs"><a href={route(locale, '/')}>{homeLabel}</a> › <span>LLMs</span></div>

<h1>{title}</h1>
<p class="muted">{description}</p>

<p style="margin: 18px 0 24px;">
  <a class="cta-btn" href="/llms.txt">{t('llms.cta.txt', locale)} →</a>
  <a class="cta-btn" href="/openapi.json" style="margin-left:8px;">Open OpenAPI spec →</a>
</p>

{sections.map(s => (
  <section class="section">
    <h2 class="section-title">{s.h}</h2>
    <p>{s.body}</p>
  </section>
))}

<section class="section">
  <h2 class="section-title">Quick endpoints</h2>
  <ul>
    <li><a href="/llms.txt">/llms.txt</a> — machine-readable product brief</li>
    <li><a href="/openapi.json">/openapi.json</a> — OpenAPI 3.0 spec for the conversion API</li>
    <li><a href="/sitemap-index.xml">/sitemap-index.xml</a> — full sitemap (1,135 URLs)</li>
    <li><a href="/robots.txt">/robots.txt</a> — robots policy + sitemap pointer</li>
    <li><a href={route(locale, '/about')}>/about</a> — editorial policy and contact</li>
  </ul>
</section>

</Base>

<style>
  .cta-btn { display: inline-block; padding: 10px 18px; background: var(--brand); color: #fff; border-radius: 8px; font-weight: 700; }
  .cta-btn:hover { text-decoration: none; }
  ul { line-height: 1.9; }
</style>
