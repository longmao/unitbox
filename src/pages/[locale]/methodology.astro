---
import Base from '~/layouts/Base.astro';
import FaqBlock from '~/components/FaqBlock.astro';
import JsonLd from '~/components/JsonLd.astro';
import { buildFaqPage } from '~/lib/seo';
import { LOCALES, t, type Locale } from '~/lib/i18n';
import { route } from '~/lib/i18n/routes';

export async function getStaticPaths() {
  const out: Array<{ params: { locale: string }; props: { locale: Locale } }> = [];
  for (const locale of LOCALES) {
    out.push({ params: { locale }, props: { locale } });
  }
  return out;
}

const { locale } = Astro.props as { locale: Locale };

const faq = [
  { q: 'Where do your conversion factors come from?', a: 'NIST Special Publication 811 (SI factors), BIPM SI Brochure, and IEC 80000-13 for data prefixes. Each unit page links to its category reference.' },
  { q: 'How do you handle KB vs KiB (decimal vs binary)?', a: 'We use KB = 1000 bytes (decimal) and KiB = 1024 bytes (binary) per IEC 80000-13. We never silently round-trip between the two.' },
  { q: 'Why are temperatures affine (not linear)?', a: 'Because 0 °C is not the same point as 0 °F or 0 K. We apply the offset (0 °C = 273.15 K, 0 °C = 32 °F) before scaling.' },
  { q: 'Why is fuel-economy shown as "reciprocal"?', a: 'L/100km and MPG-US measure efficiency in opposite directions — smaller L/100km = better, larger MPG = better. We invert one before computing.' },
];

const faqLd = buildFaqPage(faq, { inLanguage: locale === 'en' ? 'en' : locale === 'zh-hant' ? 'zh-Hant' : 'zh-Hans' });
const title = t('methodology.h1', locale);
const description = t('methodology.subtitle', locale);
const homeLabel = t('pair.breadcrumb-home', locale);
const navAbout = t('nav.about', locale);
---
<Base title={title} description={description} locale={locale} noBreadcrumb>
  <Fragment slot="head">
    <JsonLd data={faqLd} />
  </Fragment>

<div class="breadcrumbs"><a href={route(locale, '/')}>{homeLabel}</a> › <span>{navAbout}</span> › <span>{title}</span></div>

<h1>{title}</h1>
<p class="muted">{description}</p>

<h2>{t('methodology.s1.h', locale)}</h2>
<p>{t('methodology.s1.p', locale)}</p>

<h2>{t('methodology.s2.h', locale)}</h2>
<p>{t('methodology.s2.p', locale)}</p>

<h2>{t('methodology.s3.h', locale)}</h2>
<p>{t('methodology.s3.p', locale)}</p>

<h2>{t('methodology.s4.h', locale)}</h2>
<p>{t('methodology.s4.p', locale)}</p>

<h2>{t('methodology.s5.h', locale)}</h2>
<p>{t('methodology.s5.p', locale)}</p>

<FaqBlock items={faq} />

</Base>