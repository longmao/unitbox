---
import Base from '~/layouts/Base.astro';
import FaqBlock from '~/components/FaqBlock.astro';
import JsonLd from '~/components/JsonLd.astro';
import { buildFaqPage } from '~/lib/seo';
import { LOCALES, IN_LANGUAGE, t, type Locale } from '~/lib/i18n';
import { route } from '~/lib/i18n/routes';
import { ADS } from '~/lib/ads';

export async function getStaticPaths() {
  const out: Array<{ params: { locale: string }; props: { locale: Locale } }> = [];
  for (const locale of LOCALES) {
    out.push({ params: { locale }, props: { locale } });
  }
  return out;
}

const { locale } = Astro.props as { locale: Locale };

const faq = [
  { q: 'Do you set cookies?', a: 'No. unitbox runs zero cookies — no session cookie, no analytics cookie, no preference cookie.' },
  { q: 'Do you log my conversion inputs?', a: 'No. Every conversion happens client-side in your browser. Your inputs never reach a server.' },
  { q: 'Do you run ads?', a: ADS.enabled ? 'unitbox currently loads Google AdSense on configured placements. Google may use cookies or similar technologies as described in its publisher disclosures; consent controls are shown where required by law.' : 'unitbox does not currently load Google AdSense in this build. If ads are enabled in the future, this page will be updated before serving them and consent controls will be added where required.' },
  { q: 'What about Cloudflare logs and analytics?', a: 'Cloudflare (our CDN) keeps edge access logs for 24 hours, then deletes them — used for security/abuse detection only. We also enable Cloudflare Web Analytics, a cookieless, IP-free, fingerprint-free aggregate counter, to see how popular the site is. It does not track individual visitors.' },
];

const faqLd = buildFaqPage(faq, { inLanguage: IN_LANGUAGE[locale] });
const title = t('privacy.h1', locale);
const description = t('privacy.subtitle', locale);
const homeLabel = t('pair.breadcrumb-home', locale);
const navAbout = t('nav.about', locale);
---
<Base title={title} description={description} locale={locale} noBreadcrumb>
  <Fragment slot="head">
    <JsonLd data={faqLd} />
  </Fragment>

<div class="breadcrumbs"><a href={route(locale, '/')}>{homeLabel}</a> › <span>{navAbout}</span> › <span>{title}</span></div>

<h1>{title}</h1>
<p class="muted">{description}</p>
<p class="muted small">Last reviewed: November 5, 2026.</p>

<h2>{t('privacy.s1.h', locale)}</h2>
<p>{t('privacy.s1.p', locale)}</p>

<h2>{t('privacy.s2.h', locale)}</h2>
<ul>
  <li>{t('privacy.s2.li1', locale)}</li>
  <li>{t('privacy.s2.li2', locale)}</li>
  <li>{t('privacy.s2.li3', locale)}</li>
</ul>

<h2>{t('privacy.s3.h', locale)}</h2>
<ul>
  <li>{t('privacy.s3.li1', locale)}</li>
  <li>{t('privacy.s3.li2', locale)}</li>
</ul>

<h2>Advertising, cookies, and consent</h2>
<p>When Google AdSense is enabled, Google and its advertising partners may use cookies, IP addresses, web beacons, or similar technologies to serve and measure ads. Unitbox does not use conversion inputs to build advertising audiences, and ads are not shown inside the calculator interaction itself.</p>
<p>Where consent is required by law, Unitbox will request it before serving personalized advertising. Visitors can also review <a href="https://policies.google.com/technologies/partner-sites" rel="noopener">how Google uses information from sites and apps that use its services</a>.</p>

<h2>{t('privacy.s4.h', locale)}</h2>
<p>{t('privacy.s4.p', locale)} For Google advertising disclosures, see <a href="https://policies.google.com/technologies/partner-sites" rel="noopener">How Google uses information from sites or apps that use its services</a>.</p>

<FaqBlock items={faq} />

</Base>

<style>
  .small { font-size: 14px; }
</style>
