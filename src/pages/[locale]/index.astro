---
import Base from '~/layouts/Base.astro';
import ConverterWidget from '~/components/ConverterWidget.astro';
import FaqBlock from '~/components/FaqBlock.astro';
import ArticlesBlock from '~/components/ArticlesBlock.astro';
import JsonLd from '~/components/JsonLd.astro';
import { getAllCategories, getUnitsByCategory, getUnit, getCuratedPairs } from '~/lib/units';
import { articles } from '~/data/articles';
import { buildFaqPage } from '~/lib/seo';
import { LOCALES, IN_LANGUAGE, t, type Locale } from '~/lib/i18n';
import { route } from '~/lib/i18n/routes';
import { scenarios, featuredScenarioSlugs } from '~/data/scenarios';

export async function getStaticPaths() {
  const out: Array<{ params: { locale: string }; props: { locale: Locale } }> = [];
  for (const locale of LOCALES) {
    out.push({ params: { locale }, props: { locale } });
  }
  return out;
}

const { locale } = Astro.props as { locale: Locale };

const categories = getAllCategories();
const heroFromSlug = 'meter';
const heroToSlug = 'foot';

// The home page now makes the measurement work visible first; unrelated local
// utilities remain available in /tools without competing with this promise.
type HeroChip = { slug: string; label: string; meta: string };
const featuredChips: HeroChip[] = [
  { slug: 'category/data', label: 'Data storage', meta: 'decimal ↔ binary' },
  { slug: 'category/fuel-economy', label: 'Fuel economy', meta: 'MPG ↔ L/100 km' },
  { slug: 'category/length', label: 'Construction', meta: 'metric ↔ imperial' },
];

// Keep the first screen and the popular list useful. Slugs are stored as pairs,
// not parsed from a hyphenated URL, so names such as gallon-us never render as
// "gallon → to".
const popularPairs = getCuratedPairs().filter(pair => [
  'meter-to-foot', 'kilometer-to-mile', 'inch-to-centimeter',
  'kilogram-to-pound', 'celsius-to-fahrenheit', 'liter-to-gallon-us',
  'square-meter-to-square-foot', 'kilobyte-to-kibibyte', 'mpg-us-to-liter-per-100km',
].includes(pair.url));
const featuredScenarios = featuredScenarioSlugs
  .map(slug => scenarios.find(scenario => scenario.slug === slug))
  .filter((scenario): scenario is NonNullable<typeof scenario> => Boolean(scenario));

// Home page FAQ is page-local English content for v0.4. The "Build-Time
// assertion" rule (no new dict keys) keeps it page-local until they earn
// keys in en/zh-hant/zh-hans.
const faq = [
  { q: 'What is Unitbox?', a: 'Unitbox is a practical unit converter and measurement reference. It focuses on the conversions people use in everyday work: construction dimensions, data storage, fuel economy, weight, temperature and volume.' },
  { q: 'How accurate are the conversions?', a: 'All conversions use the standard SI conversion factors. For mass, length, time, the values match NIST to the precision shown. Temperature uses the affine offset/scale formulas; the precision is 2 decimal places by default.' },
  { q: 'What is the difference between KB and KiB?', a: 'KB (kilobyte) = 1000 bytes — the SI decimal prefix. KiB (kibibyte) = 1024 bytes — the binary prefix designed to remove ambiguity. Disk drives advertise KB; RAM and operating systems often show KiB. For more, see the learn page on data units.' },
  { q: 'How do you handle fuel economy?', a: 'We treat fuel-economy as a reciprocal quantity. The base unit is L/100 km (lower is better); MPG-US, MPG-UK, and km/L are stored as reciprocals. Converting 30 MPG-US gives 7.84 L/100km.' },
  { q: 'Does this work offline?', a: 'Yes. The calculation runs in your browser once the page has loaded, so a normal conversion does not require an account or a server request.' },
  { q: 'When should I verify a result elsewhere?', a: 'For legal, safety-critical, medical, scientific or contractual work, check the governing standard, instrument manual or source document. Unitbox is a practical reference, not a substitute for those requirements.' },
];

const featuredArticles = articles.slice(0, 4);
const faqLd = buildFaqPage(faq, { inLanguage: IN_LANGUAGE[locale] });

// 8/5 loop: 补导航式 query 关键词（unit converter / free / online / tool），
// 对齐 AI 可见度战场（7-31 baseline）。H1 不动（"any unit, instantly" 保品牌调性）；
// title/desc 是 SEO 元数据，用户和 AI 搜索时看。
const title = 'Practical Unit Converter & Measurement Reference';
const description = 'A practical unit converter for construction dimensions, data storage, fuel economy, weight, temperature and volume. Free, browser-based and no signup required.';
---
<Base title={title} description={description} locale={locale} noBreadcrumb>

  <Fragment slot="head">
    <JsonLd data={faqLd} />
  </Fragment>

  <!-- LAYER 1: hero with live converter (openfate-aligned) -->
  <section class="hero">
    <div class="hero-inner card">
      <div class="hero-copy">
        <p class="hero-note">A measuring desk for the web</p>
        <h1>{t('home.h1', locale)}</h1>
        <p class="hero-sub">Convert everyday measurements with a live calculator, then check the convention behind the number.</p>
      </div>
      <div class="hero-converter">
        <div class="hero-measure" aria-hidden="true"><strong>1</strong><span>meter</span><i>→</i><strong>3.28084</strong><span>feet</span></div>
        <ConverterWidget fromSlug={heroFromSlug} toSlug={heroToSlug} mode="full" defaultValue={1} />
        <div class="hero-eg">
          <span>{t('home.try', locale)}</span>
          <a href={route(locale, '/kilogram-to-pound')}>1 kg → lb</a>
          <a href={route(locale, '/celsius-to-fahrenheit')}>0 °C → °F</a>
          <a href={route(locale, '/gigabyte-to-gibibyte')}>1 GB → GiB</a>
          <a href={route(locale, '/mpg-us-to-liter-per-100km')}>30 MPG → L/100km</a>
        </div>
      </div>
      <div class="hero-meta">
        <p class="trust-band">Private browser calculation · clearly labelled conventions</p>
        <div class="hero-chips">
          {featuredChips.map(c => {
            const href = route(locale, `/${c.slug}`);
            return (
              <a class="hero-chip" href={href}>
                <span class="chip-label">{c.label}</span>
                <span class="chip-meta">{c.meta}</span>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <!-- LAYER 2: 3-step how-it-works -->
  <section class="section">
    <h2 class="section-title">{t('home.steps.title', locale)}</h2>
    <ol class="steps">
      <li class="step">
        <div class="step-num">1</div>
        <h3 class="step-title">{t('home.steps.s1.title', locale)}</h3>
        <p>{t('home.steps.s1.body', locale)}</p>
      </li>
      <li class="step">
        <div class="step-num">2</div>
        <h3 class="step-title">{t('home.steps.s2.title', locale)}</h3>
        <p>{t('home.steps.s2.body', locale)}</p>
      </li>
      <li class="step">
        <div class="step-num">3</div>
        <h3 class="step-title">{t('home.steps.s3.title', locale)}</h3>
        <p>{t('home.steps.s3.body', locale)}</p>
      </li>
    </ol>
  </section>

  <section class="section">
    <h2 class="section-title">Conversion for real work</h2>
    <p class="section-subtitle">Start from the job in front of you. Each guide includes a live calculation, the convention behind it, and the exact related conversions.</p>
    <div class="grid grid-3">
      {featuredScenarios.map(s => (
        <a class="card scenario-card" href={route('en', `/scenarios/${s.slug}/`)}>
          <h3>{s.title}</h3>
          <p>{s.description}</p>
          <span>Explore guide →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- LAYER 3: category matrix -->
  <section class="section">
    <h2 class="section-title">{t('home.browse-by-cat', locale)}</h2>
    <p class="section-subtitle">{t('home.browse-by-cat-sub', locale)}</p>
    <div class="grid grid-4">
      {categories.map(cat => {
        const catUnits = getUnitsByCategory(cat.slug);
        return (
          <a class="card category-card" href={route(locale, `/category/${cat.slug}`)}>
            <div class="cat-name">{cat.name}</div>
            <div class="cat-base">{catUnits.length} units · base: <span class="code">{cat.baseSymbol}</span></div>
            <div class="cat-desc">{cat.description}</div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- LAYER 4: popular conversion cards -->
  <section class="section">
    <h2 class="section-title">{t('home.popular', locale)}</h2>
    <p class="section-subtitle">{t('home.popular-sub', locale)}</p>
    <div class="grid grid-3">
      {popularPairs.map(({ from: fromSlug, to: toSlug }) => {
        const fromUnit = getUnit(fromSlug)!;
        const toUnit = getUnit(toSlug)!;
        return (
          <a class="card pair-card" href={route(locale, `/${fromSlug}-to-${toSlug}`)}>
            <span class="from">{fromUnit.name}</span>
            <span class="arrow">→</span>
            <span class="to">{toUnit.name}</span>
          </a>
        );
      })}
    </div>
    <p style="text-align:center; margin-top:18px;">
      <a href={route(locale, '/calculator')} class="btn btn-outline">Open the full calculator</a>
    </p>
  </section>

  <!-- LAYER 5: articles / knowledge base -->
  <section class="section">
    <h2 class="section-title">{t('home.articles', locale)}</h2>
    <ArticlesBlock articles={featuredArticles} title="" />
    <p style="text-align: center; margin-top: 16px;">
      <a href={route(locale, '/articles')} class="btn btn-outline">{t('home.all-articles', locale)}</a>
    </p>
  </section>

  <!-- LAYER 6: FAQ -->
  <section class="section">
    <FaqBlock items={faq} title={t('home.faq-title', locale)} />
  </section>

</Base>

<style>
  .hero { margin: 0 -28px; padding: 86px 28px 60px; background: #e6dbc7; overflow: hidden; }
  .hero-inner { max-width: 1280px; margin: 0 auto; padding: 0; background: transparent; color: var(--fg); border: 0; display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(32px, 7vw, 110px); align-items: center; position: relative; }
  .hero-inner::before { content: ''; position: absolute; width: min(70vw, 760px); height: min(70vw, 760px); right: -190px; top: -150px; background: var(--brand); clip-path: polygon(14% 0, 100% 0, 100% 86%, 86% 100%, 0 100%, 0 14%); z-index: 0; }
  .hero-copy, .hero-converter, .hero-meta { position: relative; z-index: 1; }
  .hero-note { margin: 0 0 18px; font-size: 13px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--fg-soft); }
  .hero-inner h1 { color: var(--fg); font-size: clamp(3.8rem, 8vw, 8rem); line-height: .88; letter-spacing: -.065em; margin-bottom: 24px; max-width: 7ch; }
  .hero-sub { color: var(--fg-soft); font-size: 18px; line-height: 1.5; margin-bottom: 24px; max-width: 34ch; }
  .hero-converter { padding: 26px; background: #efe5d3; border: 1px solid var(--brand); clip-path: polygon(0 0, 96% 0, 100% 8%, 100% 100%, 4% 100%, 0 92%); }
  .hero-measure { display: flex; align-items: baseline; gap: 10px; color: var(--brand); margin-bottom: 14px; font-variant-numeric: tabular-nums; }
  .hero-measure strong { font-size: clamp(2rem, 4vw, 4rem); line-height: .9; letter-spacing: -.06em; }
  .hero-measure span { font-size: 13px; font-weight: 600; text-transform: uppercase; }
  .hero-measure i { font-size: 28px; font-style: normal; margin: 0 8px; }
  .hero-eg { margin-top: 18px; color: var(--fg-soft); font-size: 13px; display: flex; flex-wrap: wrap; gap: 8px 14px; }
  .hero-eg a { color: var(--fg); font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }
  .trust-band { color: var(--fg-soft); font-size: 13px; margin-top: 30px; letter-spacing: .03em; }
  .hero-meta { grid-column: 1 / -1; display: flex; justify-content: space-between; align-items: end; gap: 24px; border-top: 1px solid rgba(6,43,138,.28); /* taste-skill-ignore: hero metadata boundary */ padding-top: 18px; }
  .hero-meta .trust-band { margin: 0; }
  .hero-chips { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; }
  .hero-chip { display: inline-flex; gap: 6px; align-items: baseline; padding: 8px 12px; border: 1px solid var(--brand); border-radius: 0; color: var(--fg); font-weight: 600; clip-path: polygon(0 0, 92% 0, 100% 22%, 100% 100%, 8% 100%, 0 78%); }
  .hero-chip:hover { background: var(--brand); color: #e6dbc7; text-decoration: none; }
  .hero-chip .chip-meta { color: var(--fg-soft); font-size: 12px; font-weight: 500; }
  .hero-chip:hover .chip-meta { color: #d7dfec; }
  .scenario-card h3 { margin: 0 0 8px; }
  .scenario-card p { color: var(--fg-soft); font-size: 13px; line-height: 1.5; min-height: 58px; }
  .scenario-card span { color: var(--brand); font-size: 13px; font-weight: 700; }

  /* 3-step */
  .steps { display: grid; gap: 18px; grid-template-columns: repeat(3, 1fr); padding: 0; list-style: none; margin: 16px 0; }
  .step { background: transparent; border-top: 1px solid var(--brand); /* taste-skill-ignore: numbered step boundary */ padding: 22px 0 20px; }
  .step-num { display: inline-block; color: var(--brand); font-weight: 800; margin-bottom: 10px; }
  .step-title { font-size: 18px; margin-bottom: 6px; }
  .step p { color: var(--fg-soft); font-size: 14px; line-height: 1.5; }
  @media (max-width: 800px) { .steps { grid-template-columns: 1fr; } }

  /* category + pair cards */
  .category-card { padding: 18px 20px; display: flex; flex-direction: column; gap: 6px; }
  .category-card .cat-name { font-weight: 800; font-size: 17px; }
  .category-card .cat-base { font-size: 12px; color: var(--fg-muted); }
  .category-card .cat-base .code { font-family: ui-monospace, monospace; /* taste-skill-ignore: unit symbols are code-like */ font-weight: 700; }
  .category-card .cat-desc { font-size: 13px; color: var(--fg-soft); }
  .pair-card { padding: 14px 16px; display: flex; align-items: center; gap: 10px; font-weight: 600; }
  .pair-card .from, .pair-card .to { flex: 1; font-size: 14px; }
  .pair-card .arrow { color: var(--brand); font-weight: 800; }

  @media (prefers-reduced-motion: no-preference) {
    .hero-copy { animation: hero-rise .56s ease-out both; }
    .hero-converter { animation: hero-rise .62s .1s ease-out both; }
    .hero-meta { animation: hero-rise .54s .2s ease-out both; }
    .hero-chip, .scenario-card { transition: transform .2s ease, background-color .2s ease, border-color .2s ease; }
    .scenario-card:hover { transform: translateY(-4px); }
  }

  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 700px) {
    .hero { margin: 0 -16px; padding: 58px 16px 42px; }
    .hero-inner { display: block; }
    .hero-inner::before { display: none; }
    .hero-inner h1 { font-size: clamp(3.8rem, 16vw, 6rem); }
    .hero-converter { margin-top: 44px; padding: 18px; }
    .hero-meta { display: block; }
    .hero-chips { justify-content: flex-start; margin-top: 14px; }
    .api-section { padding: 36px 22px; }
    .api-h2 { font-size: 24px; }
  }
</style>
