---
// 수기 현지화 환산 페어 페이지: 갤런 → 리터.
// ko 전용. 변환기는 실제 데이터의 gallon-us / liter 슬러그 사용
// (미국 액량 갤런 1 gal = 3.785411784 L). 영국 갤런(4.54609 L)은 본문 표에서 구분.
import Base from '~/layouts/Base.astro';
import ConverterWidget from '~/components/ConverterWidget.astro';
import FaqBlock from '~/components/FaqBlock.astro';
import RecommendedList from '~/components/RecommendedList.astro';
import JsonLd from '~/components/JsonLd.astro';
import { convert } from '~/lib/units';
import { buildFaqPage, buildHowTo, canonicalUrl } from '~/lib/seo';
import { IN_LANGUAGE, formatNumber, type Locale } from '~/lib/i18n';
import { route } from '~/lib/i18n/routes';

export async function getStaticPaths() {
  return [
    { params: { locale: 'ko' }, props: { locale: 'ko' as Locale } },
  ];
}

const { locale } = Astro.props as { locale: Locale };

const FROM = 'gallon-us'; // 미국 액량 갤런
const TO = 'liter';
const GAL_TO_L = convert(1, FROM, TO) as number;   // 3.785411784
const GAL_UK_TO_L = 4.54609;                        // 영국(제국) 갤런

const sampleValues = [0.5, 1, 2, 3, 5, 8, 10, 15, 20, 25, 30, 40, 50, 60, 80, 100];
const table = sampleValues.map(v => ({
  us: convert(v, FROM, TO) as number,
  uk: v * GAL_UK_TO_L,
  input: v,
}));

const title = '갤런에서 리터(L)로 변환 · 환산표 | 미국 갤런 3.785L, 영국 갤런 4.546L';
const subtitle = '갤런(gallon)을 리터(L)로 바로 변환하세요. 미국 액량 갤런(3.785411784 L)과 영국 갤런(4.54609 L)을 구분해서 정리하고, 500ml 콜라병·차량 연료탱크 등 생활 속 예시로 환산표를 제공합니다.';

const faq = [
  {
    q: '1갤런은 몇 리터인가요?',
    a: `측정 기준에 따라 다릅니다. 미국 액량 갤런은 정확히 ${formatNumber(GAL_TO_L, 9, locale)} L, 영국(제국) 갤런은 ${formatNumber(GAL_UK_TO_L, 5, locale)} L입니다. 변환기와 환산표는 더 널리 쓰이는 미국 갤런 기준입니다.`,
  },
  {
    q: '미국 갤런과 영국 갤런의 차이는?',
    a: `두 단위는 이름만 같고 크기가 다릅니다. 미국 액량 갤런은 231 cubic inch(3.785 L), 영국 갤런은 10 파운드의 물 부피(4.546 L)에서 유래했습니다. 같은 "1갤런"이라도 약 0.76 L, 20% 가까이 차이납니다. 미국 연비(MPG)와 영국 연료 단위를 환산할 때는 반드시 어느 쪽 갤런인지 확인해야 합니다.`,
  },
  {
    q: '물 1갤런은 500ml 콜라병 몇 병인가요?',
    a: `미국 갤런 기준 1 gal = ${formatNumber(GAL_TO_L, 4, locale)} L이므로, 500ml 병으로 약 ${formatNumber(GAL_TO_L / 0.5, 2, locale)}병입니다. "하루에 물 1갤런 마시기" 챌린지는 500ml 병 기준 7병 반가량에 해당합니다.`,
  },
  {
    q: '자동차 연료 15갤런은 몇 리터?',
    a: `미국 갤런 기준 15 gal = ${formatNumber(convert(15, FROM, TO), 2, locale)} L입니다. 미국 세단의 연료탱크(15~18 gal)는 대략 57~68 L에 해당합니다.`,
  },
  {
    q: '1리터는 몇 갤런인가요?',
    a: `미국 갤런 기준 1 L = ${formatNumber(1 / GAL_TO_L, 4, locale)} gal입니다. "리터 값 ÷ 3.785"로 갤런을 구할 수 있습니다.`,
  },
];

const related = [
  { name: '리터 → 갤런(US) (역방향)', description: '리터를 미국 갤런으로 되돌리는 환산 페이지.', href: route(locale, '/liter-to-gallon-us/') },
  { name: '갤런(US) → 갤런(UK)', description: '미국 갤런과 영국 갤런의 직접 비교 환산.', href: route(locale, '/gallon-us-to-gallon-uk/') },
  { name: '쿼트(US) → 리터', description: '1/4 갤런 단위. 해외 레시피·세제 표기에.', href: route(locale, '/quart-us-to-liter/') },
  { name: '갤런(US) (단위 페이지)', description: '미국 갤런의 정의와 유래 해설.', href: route(locale, '/gallon-us/') },
  { name: '리터 (단위 페이지)', description: '리터의 정의와 일상 쓰임 해설.', href: route(locale, '/liter/') },
];

const keepItems = [
  { name: 'MPG(US) → L/100km', description: '미국 연비 단위를 한국·유럽 연비로 환산.', href: route(locale, '/mpg-us-to-liter-per-100km/') },
  { name: 'km/L → MPG(US)', description: '국내 연비를 미국 연비 단위로.', href: route(locale, '/km-per-liter-to-mpg-us/') },
  { name: '파운드 → kg 변환', description: '헬스장 무게 표기 환산.', href: route(locale, '/pound-to-kg/') },
];

const canonical = canonicalUrl(Astro.url.pathname);
const faqLd = buildFaqPage(faq, { inLanguage: IN_LANGUAGE[locale] });
const howtoLd = buildHowTo({
  name: '갤런에서 리터로 변환하는 방법',
  description: subtitle,
  step1Name: '갤런 값 입력',
  step1Text: '위 변환기 왼쪽에 갤런(미국 액량 갤런 기준) 값을 입력합니다.',
  step2Name: '리터 결과 확인',
  step2Text: '오른쪽에 리터(L) 값이 즉시 표시됩니다. 영국 갤런 기준 값은 아래 환산표의 오른쪽 열을 참고하세요.',
  toolName: '갤런·리터 변환기',
  canonicalUrl: canonical,
});
---

<Base title={title} description={subtitle} locale={locale} altLocales={[locale]} keywords="갤런, 리터, 변환, 환산, 갤런 리터, 미국 갤런, 영국 갤런, 콜라병">
  <Fragment slot="head">
    <JsonLd data={faqLd} />
    <JsonLd data={howtoLd} />
  </Fragment>

  <div class="breadcrumbs">
    <a href={route(locale, '/')}>홈</a> ›
    <a href={route(locale, '/category/volume/')}>부피</a> ›
    <span>갤런 → 리터</span>
  </div>

  <h1>갤런에서 리터(L)로 변환</h1>
  <p class="muted">{subtitle}</p>

  <div id="converter">
    <ConverterWidget fromSlug={FROM} toSlug={TO} mode="full" defaultValue={1} />
  </div>

  <section class="section">
    <h2 class="section-title">미국 갤런과 영국 갤런, 무엇이 다른가</h2>
    <p class="section-subtitle">"갤런"은 지역에 따라 크기가 다른 두 개의 단위입니다. 어느 쪽인지 확인하는 것이 정확한 환산의 핵심입니다.</p>
    <table class="conv-table">
      <thead>
        <tr><th>단위</th><th>1갤런의 크기</th><th>쓰이는 곳</th></tr>
      </thead>
      <tbody>
        <tr class="hl">
          <td><strong>미국 액량 갤런 (gal US)</strong></td>
          <td>{formatNumber(GAL_TO_L, 9, locale)} L</td>
          <td>미국 연료·우유·세제, 라틴아메리카 일부</td>
        </tr>
        <tr>
          <td><strong>영국 갤런 (gal UK)</strong></td>
          <td>{formatNumber(GAL_UK_TO_L, 5, locale)} L</td>
          <td>영국 연료, 캐나다 일부(공식적으로는 리터)</td>
        </tr>
      </tbody>
    </table>
    <p class="muted small">위 변환기와 아래 환산표는 미국 액량 갤런 기준입니다. 미국 여행, 미국 차량, 해외 직구 제품 표기는 대부분 미국 갤런입니다.</p>
  </section>

  <section class="section">
    <h2 class="section-title">갤런 → 리터 환산표 (미국 / 영국)</h2>
    <p class="section-subtitle">생활에서 자주 쓰는 값들을 두 기준으로 나란히 정리했습니다.</p>
    <table class="conv-table">
      <thead>
        <tr><th>갤런</th><th>미국 (L)</th><th>영국 (L)</th></tr>
      </thead>
      <tbody>
        {table.map(row => (
          <tr>
            <td><strong>{formatNumber(row.input, 4, locale)}</strong> gal</td>
            <td><strong>{formatNumber(row.us, 4, locale)} L</strong></td>
            <td>{formatNumber(row.uk, 4, locale)} L</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="section">
    <h2 class="section-title">생활 속 갤런 감각</h2>
    <p class="section-subtitle">500ml 콜라병, 페트병, 차량 연료탱크로 익히는 갤런 크기 감각.</p>
    <table class="conv-table">
      <thead>
        <tr><th>항목</th><th>갤런</th><th>리터 환산</th></tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>물 1갤런 (미국 기준)</strong></td>
          <td>1 gal</td>
          <td>{formatNumber(GAL_TO_L, 3, locale)} L ＝ 500ml 콜라병 약 {formatNumber(GAL_TO_L / 0.5, 2, locale)}병 ＝ 1.5L 페트병 약 {formatNumber(GAL_TO_L / 1.5, 2, locale)}병</td>
        </tr>
        <tr>
          <td><strong>미국 소형차 연료탱크</strong></td>
          <td>12 gal</td>
          <td>{formatNumber(convert(12, FROM, TO), 1, locale)} L</td>
        </tr>
        <tr>
          <td><strong>미국 세단/Pickup 연료탱크</strong></td>
          <td>15~24 gal</td>
          <td>{formatNumber(convert(15, FROM, TO), 1, locale)}~{formatNumber(convert(24, FROM, TO), 1, locale)} L</td>
        </tr>
        <tr>
          <td><strong>우유 1갤런 팩 (미국 마트)</strong></td>
          <td>1 gal</td>
          <td>{formatNumber(GAL_TO_L, 3, locale)} L — 한국 1L 팩 3개+0.8L 분량</td>
        </tr>
      </tbody>
    </table>
  </section>

  <section class="section two-col">
    <div>
      <h3>갤런이란?</h3>
      <p>갤런(gallon)은 야드파운드법의 부피 단위입니다. 미국 액량 갤런은 정확히 3.785411784 L(231 cubic inch)로, 미국 주유소의 기름값, 대형 마트의 우유·세제 용량 표기에 쓰입니다. 영국 갤런(4.54609 L)은 10파운드 무게의 물 부피에서 유래했으며, 영국 연료 가격 표기에 아직 남아 있습니다.</p>
    </div>
    <div>
      <h3>리터(L)란?</h3>
      <p>리터는 메트릭법의 부피 단위로 1,000 cm³(1세제곱데시미터)입니다. 한국의 모든 연료·음료·세제 표기는 리터와 밀리리터 기준입니다. 갤런 → 리터는 "갤런 수 × 3.785411784"(미국 기준), 리터 → 갤런은 "리터 수 ÷ 3.785411784"로 환산합니다.</p>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">자주 묻는 질문</h2>
    <FaqBlock items={faq} />
  </section>

  <RecommendedList title="관련 환산" items={related} />

  <section class="section">
    <h2 class="section-title">더 살펴보기</h2>
    <RecommendedList title="" items={keepItems} />
  </section>

</Base>

<style>
  .conv-table { width: 100%; border-collapse: collapse; margin-top: 12px; }
  .conv-table th { background: var(--bg); color: #fff; padding: 12px 14px; text-align: left; font-size: 13px; }
  .conv-table td { padding: 12px 14px; border-bottom: 1px solid var(--border); font-variant-numeric: tabular-nums; }
  .conv-table tr.hl td { background: var(--brand-soft, #f4f0ff); }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
  .two-col h3 { font-size: 18px; margin-bottom: 6px; }
  .two-col p { margin-top: 6px; }
  .small { font-size: 13px; }
  @media (max-width: 800px) { .two-col { grid-template-columns: 1fr; } }
</style>
