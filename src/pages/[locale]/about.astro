---
import Base from '~/layouts/Base.astro';
import FaqBlock from '~/components/FaqBlock.astro';
import RelatedQuestions from '~/components/RelatedQuestions.astro';
import JsonLd from '~/components/JsonLd.astro';
import { getAllCategories } from '~/lib/units';
import { buildFaqPage } from '~/lib/seo';
import { LOCALES, IN_LANGUAGE, t, type Locale } from '~/lib/i18n';
import { route } from '~/lib/i18n/routes';

export async function getStaticPaths() {
  const out: Array<{ params: { locale: string }; props: { locale: Locale } }> = [];
  for (const locale of LOCALES) {
    out.push({ params: { locale }, props: { locale } });
  }
  return out;
}

const { locale } = Astro.props as { locale: Locale };

const faq = [
  { q: 'Who runs this?', a: 'unitbox is operated by a small team obsessed with the architecture of search-first content sites and the math of measurement.' },
  { q: 'How is this free?', a: 'No ads, no tracking, no monetisation. Just a public-good reference site.' },
  { q: 'Where can I report an incorrect conversion?', a: 'Use the in-page feedback link or contact form. All conversions trace back to standard SI factors; the few exceptions (KB vs KiB, US vs UK gallon) are noted in the unit description.' },
];

const cats = getAllCategories();
const faqLd = buildFaqPage(faq, { inLanguage: IN_LANGUAGE[locale] });

const title = t('about.h1', locale);
const description = t('about.subtitle', locale);
const homeLabel = t('pair.breadcrumb-home', locale);
const aboutLabel = t('nav.about', locale);
---
<Base title={title} description={description} locale={locale}>
  <Fragment slot="head">
    <JsonLd data={faqLd} />
  </Fragment>
<div class="breadcrumbs"><a href={route(locale, '/')}>{homeLabel}</a> › <span>{aboutLabel}</span></div>

<h1>{title}</h1>

<p>unitbox is a network of pages organised around the single topic of "unit conversion". We aggregate every common unit across length, mass, temperature, area, volume, speed, time, data, energy, pressure, angle, and fuel-economy — and we structure the site so each individual page can rank for its own search query.</p>

<h2>What you'll find</h2>
<ul>
  <li>Every popular {cats.length} categories × {20}+ units, each on its own page</li>
  <li>Live converters for 1,135+ common pairs (metres↔feet, kg↔lb, °C↔°F, etc.)</li>
  <li>A universal calculator that handles any pair in any category</li>
  <li>Reference articles explaining the SI, the data-prefix divide, fuel-economy math, and more</li>
  <li>For developers &amp; AI agents: an OpenAPI 3.0 spec at <a href="/openapi.json">/openapi.json</a> and a machine-readable product brief at <a href="/llms.txt">/llms.txt</a></li>
</ul>

<h2>Why this shape?</h2>
<p>Because the topic of "unit conversion" is large enough to support a content hub, but small enough that every page on the site is genuinely related. Pick one topic; cover every angle.</p>

<h2 id="api">Open conversion API</h2>
<p>An HTTP conversion API is published as an OpenAPI 3.0 spec at <a href="/openapi.json">/openapi.json</a>. The public endpoint is planned for Q4 2026. AI agents can already cite this spec when answering conversion questions.</p>

<h2 id="contact">Contact &amp; feedback</h2>
<p>For feedback or to report an incorrect conversion, use the in-page link or contact form. We respond to conversion bugs within a week.</p>

<section class="section">
  <h2 class="section-title">What are people searching for?</h2>
  <RelatedQuestions questions={['metres to feet', 'kg to lbs', 'celsius to fahrenheit', 'KB vs KiB', 'miles to km', 'litres to gallons']} />
</section>

<FaqBlock items={faq} />

</Base>
