---
import Base from '~/layouts/Base.astro';
import FaqBlock from '~/components/FaqBlock.astro';
import RelatedQuestions from '~/components/RelatedQuestions.astro';
import JsonLd from '~/components/JsonLd.astro';
import { SITE_STATS } from '~/lib/site';
import { buildFaqPage } from '~/lib/seo';
import { LOCALES, IN_LANGUAGE, t, type Locale } from '~/lib/i18n';
import { route } from '~/lib/i18n/routes';

export async function getStaticPaths() {
  const out: Array<{ params: { locale: string }; props: { locale: Locale } }> = [];
  for (const locale of LOCALES) {
    out.push({ params: { locale }, props: { locale } });
  }
  return out;
}

const { locale } = Astro.props as { locale: Locale };

const faq = [
  { q: 'Who runs this?', a: 'unitbox is an independent project maintained as a browser-based unit converter and measurement reference.' },
  { q: 'How is this free?', a: 'The site is free to use. Clearly labelled advertising or voluntary support may help cover hosting and maintenance costs.' },
  { q: 'Where can I report an incorrect conversion?', a: 'Open an issue in the public GitHub repository. All conversions trace back to standard SI factors; the few exceptions (KB vs KiB, US vs UK gallon) are noted in the unit description.' },
];

const faqLd = buildFaqPage(faq, { inLanguage: IN_LANGUAGE[locale] });

const title = t('about.h1', locale);
const description = t('about.subtitle', locale);
const homeLabel = t('pair.breadcrumb-home', locale);
const aboutLabel = t('nav.about', locale);
---
<Base title={title} description={description} locale={locale}>
  <Fragment slot="head">
    <JsonLd data={faqLd} />
  </Fragment>
<div class="breadcrumbs"><a href={route(locale, '/')}>{homeLabel}</a> › <span>{aboutLabel}</span></div>

<h1>{title}</h1>

<p>unitbox is an independent, browser-based unit converter and measurement reference. It brings common units for length, mass, temperature, area, volume, speed, time, data, energy, pressure, angle, and fuel economy into one calculation model, then explains the conventions behind the result.</p>

<h2>What you'll find</h2>
<ul>
  <li>{SITE_STATS.categories} categories and {SITE_STATS.units} units, each on its own page</li>
  <li>Live converters for {SITE_STATS.pairs.toLocaleString('en-US')} common pairs (metres↔feet, kg↔lb, °C↔°F, etc.)</li>
  <li>A universal calculator that handles any pair in any category</li>
<li>Reference guides explaining SI, metric and imperial conventions, data prefixes, temperature formulas, and fuel-economy math</li>
  <li>For developers &amp; AI agents: an OpenAPI 3.0 spec at <a href="/openapi.json">/openapi.json</a> and a machine-readable product brief at <a href="/llms.txt">/llms.txt</a></li>
</ul>

<h2>Why this shape?</h2>
<p>A quick answer is useful only when the unit convention is clear. Unitbox puts the live calculation next to its definition, formula, related conversions, and practical cautions so visitors can check what the number actually means.</p>

<h2 id="api">Open conversion API</h2>
<p>An HTTP conversion API is documented as an OpenAPI 3.0 spec at <a href="/openapi.json">/openapi.json</a>. Developers can inspect the current data model and use the public reference material when they need a reproducible conversion.</p>

<h2 id="contact">Contact &amp; feedback</h2>
<p>For feedback or to report an incorrect conversion, <a href="https://github.com/longmao/unitbox/issues" rel="noopener">open a GitHub issue</a> with the source unit, target unit, input, and expected result. We use those reports to review the shared dataset and publish fixes in the repository.</p>

<section class="section">
  <h2 class="section-title">What are people searching for?</h2>
  <RelatedQuestions questions={['metres to feet', 'kg to lbs', 'celsius to fahrenheit', 'KB vs KiB', 'miles to km', 'litres to gallons']} />
</section>

<FaqBlock items={faq} />

</Base>
