---
import Base from '~/layouts/Base.astro';
import RecommendedList from '~/components/RecommendedList.astro';
import { learnTopics } from '~/data/learn';
import { formatInline } from '~/lib/format';
import { LOCALES, t, tFmt, type Locale } from '~/lib/i18n';
import { route } from '~/lib/i18n/routes';

export async function getStaticPaths() {
  const out: Array<{ params: { locale: string; topic: string }; props: { locale: Locale; slug: string } }> = [];
  for (const locale of LOCALES) {
    for (const t of learnTopics) {
      out.push({
        params: { locale, topic: t.slug },
        props: { locale, slug: t.slug },
      });
    }
  }
  return out;
}

const { locale, slug } = Astro.props as { locale: Locale; slug: string };
const topic = learnTopics.find(t => t.slug === slug);
if (!topic) throw new Error(`Learn topic not found: ${slug}`);

// Markdown-ish body → paragraphs
const paragraphs = topic.body.split(/\n\n+/);
const related = (topic.relatedPairs ?? []).map(url => {
  const [from, , to] = url.split('-');
  return {
    name: `${from.replace(/-/g, ' ')} → ${to.replace(/-/g, ' ')}`,
    description: `Direct conversion page`,
    href: route(locale, `/${url}/`),
  };
});

const homeLabel = t('pair.breadcrumb-home', locale);
const learnLabel = t('learn.h1', locale);
const relatedTitle = t('learn.related', locale);
const readTimeLabel = tFmt('learn.read-time', locale, { time: topic.readTime });
---
<Base title={topic.title} description={topic.description} locale={locale}>

<div class="breadcrumbs">
  <a href={route(locale, '/')}>{homeLabel}</a> ›
  <a href={route(locale, '/learn')}>{learnLabel}</a> ›
  <span>{topic.title}</span>
</div>

<article class="learn">
  <header>
    <h1>{topic.title}</h1>
    <div class="meta">
      <span class="cat">{topic.category}</span>
      <span class="rt">{readTimeLabel}</span>
    </div>
    <p class="lead">{topic.description}</p>
  </header>

  <div class="body">
    {paragraphs.map(p => {
      if (p.startsWith('### ')) return <h3>{p.slice(4)}</h3>;
      if (p.startsWith('## ')) return <h2>{p.slice(3)}</h2>;
      const segments = formatInline(p);
      return (
        <p>
          {segments.map((seg, i) =>
            typeof seg === 'string'
              ? <span set:html={seg} />
              : <span class="math" set:html={seg.html} />
          )}
        </p>
      );
    })}
  </div>

  <aside class="margin">
    {related.length > 0 && (
      <section class="section">
        <h2 class="section-title">{relatedTitle}</h2>
        <RecommendedList title="" items={related} />
      </section>
    )}
  </aside>
</article>

</Base>

<style>
  .learn { display: grid; grid-template-columns: minmax(0, 1fr); gap: 24px; max-width: 760px; margin: 0 auto; }
  .learn header { border-bottom: 1px solid var(--border); padding-bottom: 16px; margin-bottom: 12px; }
  .learn h1 { font-size: 32px; line-height: 1.2; margin-bottom: 10px; }
  .lead { color: var(--fg-soft); font-size: 17px; line-height: 1.55; margin: 12px 0 0; }
  .meta { display: flex; gap: 14px; align-items: center; }
  .meta .cat { background: var(--brand); color: #fff; font-size: 11px; padding: 4px 10px; border-radius: 999px; text-transform: uppercase; letter-spacing: 0.06em; font-weight: 700; }
  .meta .rt { font-size: 13px; color: var(--fg-muted); }
  .body p { font-size: 16px; line-height: 1.7; color: var(--fg); margin: 14px 0; }
  .body h2 { font-size: 22px; margin-top: 26px; }
  .body h3 { font-size: 18px; margin-top: 22px; }
  .math { font-family: ui-monospace, monospace; background: var(--bg-soft); color: #fff; padding: 14px 18px; border-radius: 8px; }
</style>
