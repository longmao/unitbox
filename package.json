{
  "name": "time-now-clone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A clone of the time.now architecture: a network of pages organized around \"time\". One homepage + many city/country/tool/explanation pages. Demonstrates the principle of building a topic portal, not a single tool.",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "start": "astro dev --host 0.0.0.0",
    "build": "astro check && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "gen:articles": "node scripts/gen-articles.mjs",
    "sitemap": "node scripts/build-sitemap.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/sitemap": "^3.2.1",
    "astro": "^4.16.18",
    "luxon": "^3.5.0",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.2"
  }
}
